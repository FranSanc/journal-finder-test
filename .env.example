VITE_N8N_SCOPE_CLASSIFIER_WEBHOOK_URL=https://n8n.frontiersin.io/webhook/<scope-classifier-path>
# Optional legacy keyword-search webhook override.
# VITE_N8N_WEBHOOK_URL=https://n8n.frontiersin.io/webhook/match-journal-bq

# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored. Do not commit real keys.
#
# Reminder: this app is statically hosted, so every VITE_* var here gets
# baked into the public browser bundle. Treat them as semi-public.

# Vercel AI Gateway (used only by the keyword-search fallback)
VITE_AI_GATEWAY_API_KEY=
# VITE_AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
# VITE_AI_GATEWAY_MODEL=openai/gpt-4o-mini
